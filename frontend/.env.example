# Origem do backend Laravel. Vazio = mesma origem (em desenvolvimento, o Vite encaminha /api e /sanctum).
# Em produção com API num subdomínio, por exemplo: https://api.exemplo.co.mz
VITE_API_URL=

# Usado apenas pelo servidor de desenvolvimento do Vite para o proxy.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# URL pública do site (canonical, Open Graph, sitemap).
VITE_SITE_URL=http://localhost:5173
